<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:aop="http://www.springframework.org/schema/aop"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd http://www.springframework.org/schema/aop https://www.springframework.org/schema/aop/spring-aop.xsd http://www.springframework.org/schema/context https://www.springframework.org/schema/context/spring-context.xsd">

    <!-- 객체 생성 -->
    <bean class="kosta.service.CustomerServiceImpl" id="service"/>

    <bean class="kosta.advice.AroundAdvice" id="aroundAdvice"/>
    <bean class="kosta.advice.SampleAdvice" id="sampleAdvice"/>

    <!-- aop 설정 -->
    <aop:config>
        <aop:pointcut id="pointCut" expression="execution(* kosta.service.*.*(..))"/>
        <aop:aspect ref="aroundAdvice">
            <aop:around method="around" pointcut-ref="pointCut" />
        </aop:aspect>
        <aop:aspect ref="sampleAdvice">
            <aop:before method="before" pointcut-ref="pointCut"/>
            <aop:after-returning method="afaterReturing" pointcut-ref="pointCut" returning="returnObj"/>
            <aop:after-throwing method="afterThrowing" pointcut-ref="pointCut" throwing="e"/>
            <aop:after method="afterFinally" pointcut-ref="pointCut"/>
        </aop:aspect>
    </aop:config>



</beans>